---
// The Quidey logo: a Q whose tail is a checkmark, in --primary (Abendrot by default). The short
// arm of the check cuts a gap into the ring (a mask). Same drawing as public/quidey-logo.svg and
// the app's Logo.jsx. id: unique per page, for the mask.
const { id, class: className } = Astro.props;
---
<svg class={className} viewBox="9 5 50 50" aria-hidden="true">
    <defs>
        <mask id={`${id}-cut`} maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
            <rect width="64" height="64" fill="#fff" />
            <path d="M27 32l9 12" stroke="#000" stroke-width="10.5" stroke-linecap="round" />
        </mask>
    </defs>
    <circle class="logoStroke" cx="25" cy="27" r="12" fill="none" stroke-width="6" mask={`url(#${id}-cut)`} />
    <path class="logoStroke" d="M27 32l9 12L54 24" fill="none" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" />
</svg>
