---
// One update: release notes with pictures, as a BlogPosting
import Content from '../../layouts/Content.astro';
import { updatePosts, formatDate } from '../../posts.js';

export function getStaticPaths() {
    return updatePosts().map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content: Body } = post;
const site = Astro.site ?? new URL('https://quidey.com');
const url = new URL(`/updates/${post.slug}/`, site).href;
const toc = post.headings.filter(h => h.depth === 2);
const others = updatePosts().filter(other => other.slug !== post.slug).slice(0, 3);
const graph = [
    {
        '@type': 'BlogPosting',
        '@id': `${url}#article`,
        headline: post.title,
        description: post.description,
        inLanguage: 'de',
        url,
        mainEntityOfPage: url,
        datePublished: post.date,
        dateModified: post.updated ?? post.date,
        ...(post.image ? { image: new URL(post.image, site).href } : {}),
        ...(post.tags ? { keywords: post.tags.join(', ') } : {}),
        author: { '@type': 'Person', name: 'Eesge Masekowsky', url: 'https://quidey.com/' },
        publisher: { '@id': 'https://quidey.com/#organization' },
        isPartOf: { '@id': new URL('/updates/#blog', site).href },
    },
    {
        '@type': 'BreadcrumbList',
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Quidey', item: new URL('/', site).href },
            { '@type': 'ListItem', position: 2, name: 'Updates', item: new URL('/updates/', site).href },
            { '@type': 'ListItem', position: 3, name: post.title, item: url },
        ],
    },
];
---
<Content title={`${post.title} – Quidey Updates`} description={post.description} graph={graph} image={post.image} ogType="article" current="updates">
    <article class="article">
        <header class="articleHead">
            <ol class="crumbs">
                <li><a href="/">Quidey</a></li>
                <li><a href="/updates/">Updates</a></li>
            </ol>
            <h1 class="pageTitle">{post.title}</h1>
            <p class="pageLead">{post.description}</p>
            <p class="articleMeta">
                <time datetime={post.date}>{formatDate(post.date)}</time>
                {post.version && <span>{post.version}</span>}
            </p>
        </header>
        <div>
            <div class="prose"><Body /></div>
            <div class="articleCta">
                <p>Lust, es auszuprobieren?</p>
                <a class="darkBtn" href="https://app.quidey.com/signup">Beta-Platz sichern</a>
            </div>
            {others.length > 0 && (
                <nav class="related" aria-labelledby="more-updates">
                    <h2 id="more-updates">Frühere Updates</h2>
                    <ul class="helpList">
                        {others.map(other => <li><a class="helpCard" href={`/updates/${other.slug}/`}><strong>{other.title}</strong><span>{formatDate(other.date)}</span></a></li>)}
                    </ul>
                </nav>
            )}
        </div>
        {toc.length > 1 && (
            <nav class="toc" aria-label="Auf dieser Seite">
                <p>In diesem Update</p>
                <ol>{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
            </nav>
        )}
    </article>
</Content>
