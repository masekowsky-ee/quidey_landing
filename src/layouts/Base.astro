---
// The frame of every page: head (title, description, languages, social cards), the one typeface
// (self-hosted, the CSP allows no font hosts) and the page styles.
import '@fontsource-variable/inter';
import '../styles/landing.css';
import { COPY } from '../copy.js';

const { lang = 'de', title, description, noindex = false } = Astro.props;
const c = COPY[lang] ?? COPY.de;
const site = Astro.site ?? new URL('https://quidey.com');
const canonical = new URL(Astro.url.pathname, site).href;
const home = new URL(c.path, site).href;
const alternates = Object.values(COPY).map(c => ({ lang: c.lang, href: new URL(c.path, site).href }));
const logo = new URL('/icons/icon-512.png', site).href;
// the social card (1200 × 630, made by scripts/og-image.mjs): the hero as a picture
const image = new URL(c.meta.image, site).href;

// what search engines read about the site and the product (a data block, not a script: the CSP
// doesn't block it). WebSite gives Google the site name it shows above the result; the questions
// are the ones on the page, word for word.
const structured = JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebSite',
            '@id': 'https://quidey.com/#website',
            name: 'Quidey',
            url: 'https://quidey.com/',
            inLanguage: ['de', 'en'],
            publisher: { '@id': 'https://quidey.com/#organization' },
        },
        // the logo Google may show beside the name (a raster image, at least 112 × 112)
        {
            '@type': 'Organization',
            '@id': 'https://quidey.com/#organization',
            name: 'Quidey',
            url: 'https://quidey.com/',
            logo,
        },
        {
            '@type': 'WebPage',
            '@id': `${home}#webpage`,
            url: home,
            name: title,
            description,
            inLanguage: lang,
            isPartOf: { '@id': 'https://quidey.com/#website' },
            about: { '@id': 'https://quidey.com/#app' },
            primaryImageOfPage: image,
        },
        {
            '@type': 'SoftwareApplication',
            '@id': 'https://quidey.com/#app',
            name: 'Quidey',
            url: 'https://quidey.com/',
            applicationCategory: 'EducationalApplication',
            applicationSubCategory: lang === 'de' ? 'Lernplaner' : 'Study planner',
            operatingSystem: 'Web, Android, iOS, Windows, macOS',
            browserRequirements: 'Requires JavaScript',
            inLanguage: ['de', 'en'],
            description,
            image,
            featureList: c.meta.featureList,
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
            publisher: { '@id': 'https://quidey.com/#organization' },
        },
        {
            '@type': 'FAQPage',
            '@id': `${home}#faq`,
            inLanguage: lang,
            mainEntity: c.faq.items.map(([question, answer]) => ({
                '@type': 'Question',
                name: question,
                acceptedAnswer: { '@type': 'Answer', text: answer },
            })),
        },
    ],
});
---
<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>{title}</title>
        <meta name="description" content={description} />
        {noindex
            ? <meta name="robots" content="noindex" />
            : <>
                {/* large previews in search, Discover and social cards */}
                <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
                <link rel="canonical" href={canonical} />
                {alternates.map(a => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
                <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
                <meta name="application-name" content="Quidey" />
                <meta property="og:type" content="website" />
                <meta property="og:site_name" content="Quidey" />
                <meta property="og:title" content={title} />
                <meta property="og:description" content={description} />
                <meta property="og:url" content={canonical} />
                <meta property="og:image" content={image} />
                <meta property="og:image:type" content="image/png" />
                <meta property="og:image:width" content="1200" />
                <meta property="og:image:height" content="630" />
                <meta property="og:image:alt" content={c.meta.imageAlt} />
                <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
                <meta property="og:locale:alternate" content={lang === 'de' ? 'en_GB' : 'de_DE'} />
                <meta name="twitter:card" content="summary_large_image" />
                <meta name="twitter:title" content={title} />
                <meta name="twitter:description" content={description} />
                <meta name="twitter:image" content={image} />
                <meta name="twitter:image:alt" content={c.meta.imageAlt} />
                <script type="application/ld+json" set:html={structured} />
            </>}
        <link rel="icon" type="image/svg+xml" href="/quidey-logo.svg" />
        {/* raster fallback: browsers without SVG icons, and the favicon in search results (Google
            wants a multiple of 48 px; scripts/favicons.mjs draws it and /favicon.ico) */}
        <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
        <link rel="icon" href="/favicon.ico" sizes="48x48" />
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
        <meta name="theme-color" content="#0e0d0c" />
    </head>
    <body>
        <slot />
    </body>
</html>
