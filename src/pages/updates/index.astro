---
// Updates: what's new in Quidey, newest first (release notes with pictures)
import Content from '../../layouts/Content.astro';
import { updatePosts, formatDate } from '../../posts.js';

const posts = updatePosts();
const title = 'Updates – Neues in Quidey, dem Lernplaner';
const description = 'Was sich in Quidey getan hat: neue Funktionen für Lernen, Planen und Fokus, mit Bildern und dem, was dahintersteckt.';
const site = Astro.site ?? new URL('https://quidey.com');
const graph = [
    {
        '@type': 'Blog',
        '@id': new URL('/updates/#blog', site).href,
        url: new URL('/updates/', site).href,
        name: 'Quidey Updates',
        description,
        inLanguage: 'de',
        publisher: { '@id': 'https://quidey.com/#organization' },
        blogPost: posts.map(post => ({
            '@type': 'BlogPosting',
            headline: post.title,
            url: new URL(`/updates/${post.slug}/`, site).href,
            datePublished: post.date,
            ...(post.image ? { image: new URL(post.image, site).href } : {}),
        })),
    },
];
---
<Content title={title} description={description} graph={graph} current="updates">
    <div class="listHead">
        <div>
            <p class="kicker">Updates</p>
            <h1 class="pageTitle">Neu in Quidey</h1>
            <p class="pageLead">Was ich an Quidey gebaut habe, was sich geändert hat und warum. Als <a href="/updates/rss.xml">RSS-Feed</a> zum Abonnieren.</p>
        </div>
    </div>
    <ul class="updateList">
        {posts.map((post, i) => (
            <li>
                <a class="updateCard" href={`/updates/${post.slug}/`}>
                    {post.image && <img src={post.image} alt={post.imageAlt ?? ''} width="1600" height="900" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />}
                    <div>
                        <time datetime={post.date}>{formatDate(post.date)}</time>
                        <h2>{post.title}</h2>
                        <p>{post.description}</p>
                    </div>
                </a>
            </li>
        ))}
    </ul>
</Content>
